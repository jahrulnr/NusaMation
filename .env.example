# NusaMation runtime configuration (all optional)
# Copy to .env and export, or set these in your process manager.

NUSAMATION_ADDR=127.0.0.1:8787
NUSAMATION_DATA_DIR=/home/you/.nusamation
NUSAMATION_PUBLIC_URL=https://agent.example.com
NUSAMATION_PASSWORD=change-this-before-first-run
NUSAMATION_LOG_LEVEL=info
NUSAMATION_NO_WHATSAPP=0
NUSAMATION_OPEN=0
NUSAMATION_DEV=0
